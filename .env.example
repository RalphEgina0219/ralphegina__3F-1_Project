# Optional settings for compose.yaml (docs/DOCKER.md). Docker works without this file; copy it to
# .env (next to compose.yaml) only to change a port, then run: docker compose up -d
# This is not Laravel's .env (that one is laravel-backend/.env).

# Host port of the API (nginx). Change it if something else already uses 8000; then also set
# VITE_API_PROXY_TARGET=http://localhost:<port> in react-frontend/.env.development.local.
LAUNDRYFLOW_API_PORT=8000

# Host port of MySQL, for HeidiSQL or MySQL Workbench (3307, so Laragon's 3306 stays free).
LAUNDRYFLOW_DB_PORT=3307

# Host port of phpMyAdmin (npm run db:admin).
LAUNDRYFLOW_PMA_PORT=8080

# The user and group ids the PHP container runs as. Inside WSL2, set them to the output of
# `id -u` and `id -g`, then rebuild (npm run backend:up). On Windows folders, 1000 is fine.
LAUNDRYFLOW_UID=1000
LAUNDRYFLOW_GID=1000
