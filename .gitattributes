# Files that run inside Linux containers must keep LF line endings, even on a Windows checkout
# (a CRLF entrypoint fails with "no such file or directory").
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.sql       text eol=lf
*.ini       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf

# Windows launchers keep CRLF.
*.bat       text eol=crlf
