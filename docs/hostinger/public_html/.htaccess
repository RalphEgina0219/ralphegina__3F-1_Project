# LaundryFlow on Hostinger (docs/HOSTINGER.md): one domain, two apps.
#   /api/*  and /up  -> laravel.php (Laravel, installed outside public_html)
#   /manifest.webmanifest and /storage/branding/*  -> laravel.php too: the installed-app manifest and
#                      the shop's uploaded logo and icons come from the branding settings
#   a real file      -> served as is (index.html, assets/, sw.js, icons)
#   anything else    -> index.html (React Router: /orders, /scan, /my ...)
# Browser and API share one origin, so CORS is never involved.

Options -MultiViews -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTP -> HTTPS. Phones need HTTPS for the camera (QR scanner) and to install the app.
    # Hostinger's own "Force HTTPS" switch does the same; either one is enough.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # The Bearer token (JWT) must reach PHP.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # laravel.php is reached only through the rule below, never by its own URL.
    RewriteCond %{THE_REQUEST} \s/+laravel\.php[\s?/] [NC]
    RewriteRule ^ - [R=404,L]

    # The API, Laravel's health check, the branded manifest and the uploaded logos and icons.
    # (public_html has no manifest.webmanifest or storage/ folder: Laravel answers these.)
    RewriteRule ^(api/|up$|manifest\.webmanifest$|storage/branding/) laravel.php [L]

    # Files and folders that exist are served directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Every other path is a screen of the single-page app.
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # The app shell, the service worker and the manifest must never be served stale, or
    # updates stop arriving. The hashed files in assets/ never change, so they cache for a year.
    <FilesMatch "^(index\.html|sw\.js|registerSW\.js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# Never serve dotfiles (except Let's Encrypt's challenge folder).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
