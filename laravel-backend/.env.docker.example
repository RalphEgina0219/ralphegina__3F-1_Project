# The Laravel .env for Docker (docs/DOCKER.md). The app container copies it to .env on its first
# start when there is no .env yet, then fills APP_KEY and JWT_SECRET. Under Laragon, use
# .env.example instead. compose.yaml also passes DB_* and APP_URL as environment variables, which
# Laravel prefers over .env, so a Laragon .env works in Docker too.
APP_NAME=LaundryFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The "db" service in compose.yaml. These credentials exist only inside Docker (the port is bound
# to 127.0.0.1:3307 on the host), never use them on a real server.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laundryflow
DB_USERNAME=laundryflow
DB_PASSWORD=laundryflow
DB_TIMEZONE=+08:00

# The React dev server, for CORS (not needed while Vite proxies /api).
FRONTEND_URL=http://localhost:5173

# Filled in by the container on its first start (php artisan jwt:secret).
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SCRIBE_AUTH_KEY=
