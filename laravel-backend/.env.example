APP_NAME=LaundryFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Laragon's Apache virtual host (README: "Run the whole system in 5 minutes"). With
# php artisan serve instead: http://127.0.0.1:8000
APP_URL=http://laundryflow.test
# Every date in reports is a Manila day; the database session runs at +08:00 too (DB_TIMEZONE).
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 / MariaDB (XAMPP or Laragon: root with an empty password by default).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laundryflow
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=+08:00

# The React app's origin(s), comma separated, for CORS (not needed when Vite proxies /api).
FRONTEND_URL=http://localhost:5173

# JWT (course L8). Generate the secret with: php artisan jwt:secret
JWT_SECRET=
JWT_ALGO=HS256
# Access token lifetime in minutes; an expired token can be refreshed for JWT_REFRESH_TTL minutes.
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true

# Sanctum is installed by php artisan install:api (course L3) but unused: authentication is JWT.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Also holds the JWT blacklist and the login rate limits.
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Only for php artisan scribe:generate: a staff token for the example responses.
SCRIBE_AUTH_KEY=

# --- Production -------------------------------------------------------------------------------
# Hostinger: start from .env.hostinger.example instead (guide: ../docs/HOSTINGER.md).
# On a real server, change these (everything else above stays as it is):
#   APP_ENV=production
#   APP_DEBUG=false                 # never true in production: errors would show file paths
#   APP_URL=https://api.your-shop.example
#   FRONTEND_URL=https://app.your-shop.example   # the only origin(s) CORS accepts
#   LOG_LEVEL=warning
#   DB_PASSWORD=<a real password>   # and a DB user with rights on this database only
#   JWT_SECRET=<php artisan jwt:secret on the server; never copied from another machine>
# Serve both sites over HTTPS only (see laravel-backend/README.md, "Production hardening"),
# then run: php artisan optimize   (config, routes, events and views cached)
