# LaundryFlow API on Hostinger (docs/HOSTINGER.md, step 5). On the server:
#   cp .env.hostinger.example .env   then replace every <...> below, then:
#   php artisan key:generate --force && php artisan jwt:secret --force
# Never commit the filled-in .env, and never copy one from another machine.

APP_NAME=LaundryFlow
APP_ENV=production
# Never true on a public server: a crash would show file paths and SQL.
APP_DEBUG=false
APP_KEY=
# The site's address, https:// and no trailing slash. The React app and the API share it.
APP_URL=https://<your-domain>
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# daily: one file a day in storage/logs, the last 14 kept (shared hosting has little disk).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# hPanel > Databases > MySQL Databases. Hostinger prefixes both names with your account
# (u123456789_...). The host is localhost unless that page shows another one.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<u123456789_laundryflow>
DB_USERNAME=<u123456789_laundryflow>
DB_PASSWORD=<the database user's password>
DB_TIMEZONE=+08:00

# Same origin as the API, so CORS is not used; kept for a later split onto two domains.
FRONTEND_URL=https://<your-domain>

# Empty unless Hostinger CDN or Cloudflare is turned on for the domain: then set * so the
# sign-in and registration limits count each visitor, not the CDN (config/app.php).
TRUSTED_PROXIES=

# Generated on the server: php artisan jwt:secret --force
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Also holds the JWT blacklist and the login rate limits.
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@<your-domain>"
MAIL_FROM_NAME="${APP_NAME}"
