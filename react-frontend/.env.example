# Base URL of the Laravel API, versioned (course: /api/v1). In development Vite proxies /api to
# Laravel, so the same path works (see VITE_API_PROXY_TARGET below).
# For a separate API host use the full URL, e.g. https://api.example.com/api/v1 (then set CORS).
VITE_API_URL=/api/v1
# Public origin encoded into basket QR labels. Empty = the current browser origin.
VITE_PUBLIC_URL=
# true = serve the API from the in-browser MSW mock (build:demo and the unit tests only).
VITE_USE_MOCKS=false
# Where `npm run dev` and `npm run preview` proxy /api (../docs/DOCKER.md). Left empty:
# http://localhost:8000 when it answers (Docker, or php artisan serve), else http://laundryflow.test
# when it resolves and answers (Laragon), else http://localhost:8000 with a hint to start Docker.
# Set it to force one: http://localhost:8000 (Docker), http://laundryflow.test (Laragon) or
# http://127.0.0.1:8000 (php artisan serve). The older name API_PROXY_TARGET still works.
VITE_API_PROXY_TARGET=
