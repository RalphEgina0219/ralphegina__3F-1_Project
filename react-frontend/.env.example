# Base URL of the Laravel API, versioned (course: /api/v1). In development Vite proxies /api to
# Laravel, so the same path works (see API_PROXY_TARGET below).
# For a separate API host use the full URL, e.g. https://api.example.com/api/v1 (then set CORS).
VITE_API_URL=/api/v1
# Public origin encoded into basket QR labels. Empty = the current browser origin.
VITE_PUBLIC_URL=
# true = serve the API from the in-browser MSW mock (build:demo and the unit tests only).
VITE_USE_MOCKS=false
# Where `npm run dev` and `npm run preview` proxy /api. Left empty: http://laundryflow.test
# (Laragon's Apache, fast and parallel) when that name resolves, else http://127.0.0.1:8000
# (php artisan serve). Set it to force one, e.g. API_PROXY_TARGET=http://127.0.0.1:8000
API_PROXY_TARGET=
