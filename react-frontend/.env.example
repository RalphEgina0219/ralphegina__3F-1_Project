# Base URL of the REST API. Same-origin /api works with the mock worker and with a proxied Laravel app.
VITE_API_URL=/api
# Public origin encoded into order QR codes. Empty = the current browser origin.
VITE_PUBLIC_URL=
# true = serve the API from the in-browser MSW mock. Set to false in Phase 2.
VITE_USE_MOCKS=true
