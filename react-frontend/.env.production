# `npm run build` (and `npm run build:hostinger` at the project root): the real-API build.
# The API is on the same origin as the app (docs/HOSTINGER.md), so a path is enough.
# For an API on another host use its full URL, e.g. https://api.example.com/api/v1 (then CORS).
VITE_API_URL=/api/v1
# Public origin encoded into basket QR labels. Empty = the address the app is opened at.
VITE_PUBLIC_URL=
VITE_USE_MOCKS=false
